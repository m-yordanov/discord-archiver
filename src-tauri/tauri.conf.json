{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Archiver",
  "version": "0.1.0",
  "identifier": "com.discord-archiver.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Archiver",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.discordapp.com https://*.discordapp.net https://*.discord.com https://web.archive.org",
        "media-src": "'self' blob: https://*.discordapp.com https://*.discordapp.net https://*.discord.com https://web.archive.org",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.discordapp.com https://*.discordapp.net https://*.discord.com https://web.archive.org",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
